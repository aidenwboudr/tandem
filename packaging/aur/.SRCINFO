pkgbase = tandem-phone
	pkgdesc = Your Android phone and your Linux computer, working as one (clipboard, notifications, calls, files, headphones)
	pkgver = 3.1.1
	pkgrel = 1
	url = https://tandem.aidenwb.com
	install = tandem-phone.install
	arch = any
	license = GPL-3.0-only
	depends = python
	depends = systemd
	depends = bluez
	depends = openssl
	depends = iproute2
	optdepends = libadwaita: the Tandem window (settings, pairing)
	optdepends = python-gobject: the Tandem window, replying to messages
	optdepends = wl-clipboard: clipboard on Wayland
	optdepends = xclip: clipboard on X11 and GNOME
	optdepends = glib2: notification buttons (gdbus)
	optdepends = pipewire: sharing headphones
	optdepends = opus: compressed audio to the phone
	optdepends = zenity: replying to messages
	optdepends = scrcpy: tandem screen
	optdepends = android-tools: tandem screen
	conflicts = tandem
	source = tandem-3.1.1.tar.gz::https://github.com/aidenwboudr/tandem/archive/refs/tags/v3.1.1.tar.gz
	sha256sums = SKIP

pkgname = tandem-phone
