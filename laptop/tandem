#!/usr/bin/python3
"""tandem: your phone and your Linux computer, working as one. See `tandem help`."""
import os
import sys

# From the repo: next to this file; install.sh: ~/.local/lib/tandem; packages: /usr/lib/tandem.
here = os.path.dirname(os.path.realpath(__file__))
for d in (here, os.path.expanduser("~/.local/lib/tandem"), "/usr/lib/tandem"):
    if os.path.isdir(os.path.join(d, "tandemd")):
        sys.path.insert(0, d)
        break

from tandemd.cli import main  # noqa: E402

main()
