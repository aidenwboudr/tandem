[Unit]
Description=Tandem: your phone and this computer, working as one
After=pipewire.service wireplumber.service graphical-session.target
Wants=pipewire.service

[Service]
ExecStart=%h/.local/bin/tandem run
# Never leave the headphones blocked if the daemon dies mid-handoff.
ExecStopPost=%h/.local/bin/tandem cleanup
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
