def strip_jsonc(text):
    """JSON with // and /* */ comments and trailing commas -> JSON (string-aware)."""
    out, i, n, in_str = [], 0, len(text), False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\":
                out.append(text[i + 1:i + 2])
                i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif text.startswith("//", i):
            i = text.find("\n", i)
            if i < 0:
                break
            continue
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        else:
            out.append(c)
        i += 1
    return re.sub(r",(\s*[}\]])", r"\1", "".join(out))



def _read(path):
    with open(path) as f:
        return f.read()


def _write(path, text):
    with open(path + ".tmp", "w") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def _backup(path):
    b = path + ".bak.pre-tandem"
    if os.path.exists(path) and not os.path.exists(b) and not os.path.exists(path + ".bak.pre-" + LEGACY):
        _write(b, _read(path))


def _add_include(text, inc):
    m = re.search(r'("include"\s*:\s*\[)([^\]]*)\]', text)
    if not m:
        sys.exit("waybar config has no include list")
    if inc in m.group(2):
        return text
    inner = m.group(2).rstrip()
    return text[:m.start(2)] + inner + (", " if inner.strip() else "") + '"' + inc + '"' + text[m.end(2):]


def _remove_include(text, inc):
    return re.sub(r',?\s*"' + re.escape(inc) + '"', "", text)


def _strip_style(css):
    for start, end in ((STYLE_START, STYLE_END), ("/* %s:start */" % LEGACY, "/* %s:end */" % LEGACY)):
        css = re.sub(re.escape(start) + r".*?" + re.escape(end) + r"\n?", "", css, flags=re.S)
    return re.sub(r"\n?" + re.escape(OLD_STYLE_MARK) + r"\n[^\n]*\n?", "\n", css)


def setup_waybar():
    audio = GEOM["audio_module"]
    text = _read(WAYBAR_CONFIG)
    _backup(WAYBAR_CONFIG)
    # 1. Undo the earlier "move the module to the center" version, if it was installed.
    text = re.sub(r'"modules-right-base"(\s*:)', r'"modules-right"\1', text)
    text = _remove_include(text, OLD_LAYOUT_INCLUDE)
    if os.path.exists(OLD_LAYOUT):
        os.unlink(OLD_LAYOUT)
    # ...and the momentum-share names from before the rename.
    text = text.replace('"cffi/%s"' % LEGACY, '"%s"' % CFFI_NAME)
    text = _remove_include(text, LEGACY_INCLUDE)
    if os.path.exists(LEGACY_GEN):
        os.unlink(LEGACY_GEN)
    # 2. The hover module sits right after the audio module (it also shows the shared-audio icon).
    cfg = json.loads(strip_jsonc(text))
    right = cfg.get("modules-right") or []
    if CFFI_NAME not in right:
        m = re.search(r'("modules-right"\s*:\s*\[[^\]]*?"' + re.escape(audio) + r'")(\s*,?)', text, flags=re.S)
        if not m:
            sys.exit(f'"{audio}" is not in modules-right; set "audio_module" in {CONFIG}')
        text = text[:m.end(1)] + ', "' + CFFI_NAME + '"' + text[m.end(1):]
    text = _add_include(text, GEN_INCLUDE)
    json.loads(strip_jsonc(text))  # still valid?
    _write(WAYBAR_CONFIG, text)
    os.makedirs(os.path.dirname(GEN), exist_ok=True)
    so = os.environ.get("TANDEM_HOVER_SO") or HOVER_SO
    _write(GEN, json.dumps({CFFI_NAME: {"module_path": so, "target": audio}}, indent=2) + "\n")
    # 3. The mixer replaces pavucontrol: drop the module's on-click.
    try:
        mods = _read(WAYBAR_MODULES)
        new = re.sub(r'\n([ \t]*)"on-click"[ \t]*:[ \t]*"pavucontrol"[ \t]*,?', r'\n\1// on-click: hover/click opens tandem-mixer', mods)
        new = new.replace(LEGACY_ONCLICK, "// on-click: hover/click opens tandem-mixer")
        if new != mods:
            _backup(WAYBAR_MODULES)
            json.loads(strip_jsonc(new))
            _write(WAYBAR_MODULES, new)
    except OSError:
        pass
    # 4. Style for the shared-audio icon (tucked against the volume).
    try:
        css = _strip_style(_read(WAYBAR_STYLE))
        _write(WAYBAR_STYLE, css.rstrip("\n") + "\n\n" + STYLE_START + "\n"
               "#tandem { color: @blue; padding: 0 12px 0 0; margin-left: -8px; }\n" + STYLE_END + "\n")
    except OSError:
        pass
    subprocess.run(["pkill", "-USR2", "-x", "waybar"], capture_output=True)
    print("waybar: hover module added after", audio, "(backups: *.bak.pre-tandem)")


def restore_waybar():
    text = _read(WAYBAR_CONFIG)
    for name in (CFFI_NAME, "cffi/" + LEGACY):
        text = re.sub(r',\s*"' + re.escape(name) + '"', "", text)
    text = re.sub(r'"modules-right-base"(\s*:)', r'"modules-right"\1', text)
    for inc in (GEN_INCLUDE, OLD_LAYOUT_INCLUDE, LEGACY_INCLUDE):
        text = _remove_include(text, inc)
    _write(WAYBAR_CONFIG, text)
    try:
        mods = _read(WAYBAR_MODULES)
        for mark in ("// on-click: hover/click opens tandem-mixer", LEGACY_ONCLICK):
            mods = mods.replace(mark, '"on-click": "pavucontrol"')
        _write(WAYBAR_MODULES, mods)
        _write(WAYBAR_STYLE, _strip_style(_read(WAYBAR_STYLE)).rstrip("\n") + "\n")
    except OSError:
        pass
    for p in (GEN, OLD_LAYOUT, LEGACY_GEN):
        if os.path.exists(p):
            os.unlink(p)
    subprocess.run(["pkill", "-USR2", "-x", "waybar"], capture_output=True)
    print("waybar restored")


