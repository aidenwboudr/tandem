def read_state():
    try:
        with open(STATE) as f:
            st = json.load(f)
        return st if time.time() - st.get("updated", 0) < 10 else None
    except (OSError, ValueError):
        return None


def ctl(**cmd):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        s.sendto(json.dumps(cmd).encode(), CTL)
    except OSError:
        pass
    finally:
        s.close()


class Avrcp:
    """The phone's player over Bluetooth (BlueZ MediaPlayer1), for when the laptop has the headphones."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

    def player(self, mac):
        try:
            r = self.bus.call_sync("org.bluez", "/", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects",
                                   None, None, Gio.DBusCallFlags.NONE, 500, None)
        except GLib.Error:
            return None
        dev = "dev_" + mac.replace(":", "_")
        for path, ifaces in r.unpack()[0].items():
            mp = ifaces.get("org.bluez.MediaPlayer1")
            if mp and dev in path:
                t = mp.get("Track") or {}
                title = t.get("Title", "")
                return {"path": path, "status": mp.get("Status", ""),
                        "title": "" if title == "Not Provided" else title,  # BlueZ's placeholder while idle
                        "artist": t.get("Artist", ""), "name": mp.get("Name", ""),
                        "length": (t.get("Duration") or 0) / 1000, "position": (mp.get("Position") or 0) / 1000}
        return None

    def toggle(self, path, playing):
        self.command(path, "Pause" if playing else "Play")

    def command(self, path, method):  # Play / Pause / Next / Previous
        try:
            self.bus.call_sync("org.bluez", path, "org.bluez.MediaPlayer1", method,
                               None, None, Gio.DBusCallFlags.NONE, 1000, None)
        except GLib.Error:
            pass


