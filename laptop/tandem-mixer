def fetch_art(url):
    """Local path for an art URL (file:// as-is, http(s) cached in ~/.cache); None until downloaded."""
    if not url:
        return None
    if url.startswith("file://"):
        p = GLib.filename_from_uri(url)[0]
        return p if os.path.exists(p) else None
    if not url.startswith(("http://", "https://")):
        return None
    import hashlib
    path = os.path.join(ART_CACHE, hashlib.sha1(url.encode()).hexdigest() + ".img")
    if os.path.exists(path):
        return path
    if url not in fetch_art.pending:
        fetch_art.pending.add(url)

        def get():
            import urllib.request
            try:
                os.makedirs(ART_CACHE, exist_ok=True)
                with urllib.request.urlopen(url, timeout=8) as r:
                    data = r.read(2_000_000)
                with open(path + ".tmp", "wb") as f:
                    f.write(data)
                os.replace(path + ".tmp", path)
            except OSError:
                pass
            finally:
                fetch_art.pending.discard(url)
        import threading
        threading.Thread(target=get, daemon=True).start()
    return None


fetch_art.pending = set()


def art_tint(path):
    """Average color of the cover (for the pill's glow), or None."""
    try:
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 8, 8, False)
    except (GLib.Error, ValueError):
        return None
    px, n, stride = pb.get_pixels(), pb.get_n_channels(), pb.get_rowstride()
    r = g = b = 0
    count = 0
    for y in range(pb.get_height()):
        for x in range(pb.get_width()):
            i = y * stride + x * n
            r, g, b, count = r + px[i], g + px[i + 1], b + px[i + 2], count + 1
    return (r // count, g // count, b // count) if count else None


class NowPlaying:
    """A pill in the middle of the bar: cover, song, ⏮ ⏯ ⏭, progress. Crossfades between tracks."""

