        self.note.show()

    def update(self, prefer, owner):
        """prefer: the setting; owner: who has the headphones right now."""
        done = owner == prefer
        for key, b in self.buttons.items():
            ctx = b.get_style_context()
            (ctx.add_class if key == prefer and done else ctx.remove_class)("on")
            (ctx.add_class if key == prefer and not done else ctx.remove_class)("pending")
        if not done:
            text = f"Handing the headphones to the {prefer}…"
        elif prefer == "laptop":
            text = "Phone audio plays through the laptop"
        else:
            text = "Laptop audio plays through the phone"
        if self.note.get_text() != text:
            self.note.set_text(text)


class Section(Gtk.Box):
    """A master row, optional device buttons, and a list of rows keyed by id."""

    def __init__(self, empty_text=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.on_master = lambda v: None
        self.on_master_mute = lambda: None
        self.master = Row(lambda: None, lambda v: self.on_master(v), lambda: self.on_master_mute(), master=True)
        self.pack_start(self.master, False, False, 0)
        self.devices = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.devices.set_halign(Gtk.Align.START)
        self.pack_start(self.devices, False, False, 0)
        self.dev_buttons = {}
        self.rows = {}
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.pack_start(self.list, False, False, 0)
        self.empty = Gtk.Label(label=empty_text or "", xalign=0)
        self.empty.get_style_context().add_class("empty")
        self.pack_start(self.empty, False, False, 0)
        self.empty_text = empty_text
        for w in (self.devices, self.list, self.empty):  # shown explicitly by sync*()
            w.set_no_show_all(True)
            w.hide()

    def sync_devices(self, devices, on_pick):
        """devices: [(id, label, current)]; hidden when there's only one."""
        seen = set()
        for did, label, current in devices:
            seen.add(did)
            b = self.dev_buttons.get(did)
            if b is None:
                b = self.dev_buttons[did] = Gtk.Button(label=label)
                b.get_style_context().add_class("dev")
                b.get_child().set_xalign(0)
                b.set_halign(Gtk.Align.START)
                b.connect("clicked", lambda _b, d=did: on_pick(d))
                self.devices.pack_start(b, False, False, 0)
                b.show_all()
            b.set_label(("● " if current else "") + label)
            ctx = b.get_style_context()
            (ctx.add_class if current else ctx.remove_class)("current")
        for did in list(self.dev_buttons):
            if did not in seen:
                self.devices.remove(self.dev_buttons.pop(did))
        self.devices.set_visible(len(devices) > 1)
        if len(devices) > 1:
            self.devices.show_all()

    def sync(self, items, make_callbacks):
        """items: [{id, app, title, volume, mute, playing}] in display order."""
        seen = set()
        for i, it in enumerate(items):
            seen.add(it["id"])
            row = self.rows.get(it["id"])
            if row is None:
                row = self.rows[it["id"]] = Row(*make_callbacks(it["id"]))
                self.list.pack_start(row, False, False, 0)
                row.show_all()
            self.list.reorder_child(row, i)
            row.update(it["app"], it.get("title"), it.get("volume"), it.get("mute", False), it.get("playing"))
        for rid in list(self.rows):
            if rid not in seen:
                self.list.remove(self.rows.pop(rid))
        self.list.set_visible(bool(items))
        self.empty.set_visible(bool(self.empty_text) and not items)


