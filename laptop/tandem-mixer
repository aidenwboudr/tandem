def main():
    if "--setup-waybar" in sys.argv:
        return setup_waybar()
    if "--restore-waybar" in sys.argv:
        return restore_waybar()
    if "--toggle" in sys.argv:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        try:
            s.sendto(b"toggle", SOCK)
        except OSError:
            sys.exit("tandem-mixer isn't running")
        return
    if GtkLayerShell is None and not DEMO and not os.environ.get("TANDEM_MIXER_TEST"):
        sys.exit("needs gtk-layer-shell: sudo apt install gir1.2-gtklayershell-0.1")
    m = Mixer()

    def quit_(*_):
        try:
            os.unlink(INDICATOR)
        except OSError:
            pass
        try:
            if os.stat(SOCK).st_ino == m.sock_ino:  # not a newer instance's socket
                os.unlink(SOCK)
        except OSError:
            pass
        m.sock.close()
        Gtk.main_quit()
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        add_signal = GLibUnix.signal_add
    except (ValueError, ImportError):
        add_signal = GLib.unix_signal_add
    for sig in (signal.SIGTERM, signal.SIGINT):
        add_signal(GLib.PRIORITY_DEFAULT, sig, quit_)
    Gtk.main()


if __name__ == "__main__":
    main()
