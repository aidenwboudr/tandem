class Fader:
    """Crossfades a widget in and out (blends, never hard cuts)."""

    def __init__(self, widget, on_hidden, ms=160):
        self.w, self.on_hidden, self.ms = widget, on_hidden, ms
        self.target, self.anim = 0.0, None
        widget.set_opacity(0.0)

    def to(self, target):
        self.target = target
        if self.anim is None:
            self.t0, self.start = time.monotonic(), self.w.get_opacity()
            self.anim = GLib.timeout_add(16, self._step)
        else:
            self.t0, self.start = time.monotonic(), self.w.get_opacity()

    def _step(self):
        k = min(1.0, (time.monotonic() - self.t0) * 1000 / self.ms)
        k = 1 - (1 - k) ** 3  # ease-out
        self.w.set_opacity(self.start + (self.target - self.start) * k)
        if k >= 1.0:
            self.anim = None
            if self.target == 0.0:
                self.on_hidden()
            return False
        return True



