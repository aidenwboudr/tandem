        title.get_style_context().add_class("section")
        top.pack_start(title, False, False, 0)
        seg = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        seg.get_style_context().add_class("seg")
        self.buttons = {}
        for key, label in (("laptop", "Laptop"), ("phone", "Phone")):
            b = Gtk.Button(label=label)
            b.get_style_context().add_class("seg-b")
            b.connect("clicked", lambda _b, k=key: on_pick(k))
            seg.pack_start(b, False, False, 0)
            self.buttons[key] = b
        top.pack_end(seg, False, False, 0)
        self.pack_start(top, False, False, 0)
