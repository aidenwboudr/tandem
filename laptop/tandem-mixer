        except OSError:
            pass
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.sock.bind(SOCK)
        self.sock_ino = os.stat(SOCK).st_ino
        self.sock.setblocking(False)
        GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN, self.on_message)

    def on_message(self, *_):
        while True:
            try:
                msg = self.sock.recv(256).decode(errors="replace").split()
            except BlockingIOError:
                return True
            if not msg:
                continue
            if msg[0] == "enter" and len(msg) >= 3:
                self.anchor = (int(msg[1]), int(msg[2]))
                self.hover("module", True)
            elif msg[0] == "leave":
                self.hover("module", False)
            elif msg[0] == "click":
                self.pinned = not (self.pinned and self.win.get_visible())
                (self.show if self.pinned else self.hide)()
            elif msg[0] == "layout" and len(msg) >= 4:
                self.np.set_bounds(int(msg[1]), int(msg[2]), int(msg[3]))
            elif msg[0] == "hello":
                self.np.remap()
            elif msg[0] == "toggle":
                self.pinned = not self.win.get_visible() or self.fade.target == 0
                (self.show if self.pinned else self.hide)()

    # -- open on hover, close shortly after the pointer leaves both (unless pinned by a click)
    def hover(self, which, inside):
        setattr(self, "hover_" + which, inside)
        if self.hover_module or self.hover_pop:
            if self.hide_timer:
                GLib.source_remove(self.hide_timer)
                self.hide_timer = None
            self.show()
        elif not self.hide_timer and not self.pinned:
            self.hide_timer = GLib.timeout_add(350, self.hide)

    def pop_leave(self, widget, event):
        # GTK sends leave when the pointer moves onto a child (a slider); only real exits count.
        if event.detail != Gdk.NotifyType.INFERIOR:
            self.hover("pop", False)

    def show(self):
        if not self.win.get_visible():
            self.refresh(force=True)
            self.place()
            self.win.show_all()
            self.refresh(force=True)  # show_all() reveals widgets update() hid on purpose
        self.fade.to(1.0)

    def hide(self):
        self.hide_timer = None
        self.pinned = False
        if not DEMO:
            self.fade.to(0.0)
        return False

    def place(self):
        """Center the mixer under the audio module, kept on screen."""
        if GtkLayerShell is None or not self.anchor:
            return
        x, w = self.anchor
        mon = Gdk.Display.get_default().get_monitor(0)
        screen_w = mon.get_geometry().width if mon else 1920
        left = GEOM["bar_margin_left"] + x + w // 2 - GEOM["width"] // 2
        left = max(4, min(left, screen_w - GEOM["width"] - 6))
        GtkLayerShell.set_margin(self.win, GtkLayerShell.Edge.LEFT, left)

    # -- actions
    def set_default_volume(self, key, v):
        n = default_node(self.objs, key)
        if n:
            wpctl("set-volume", n["id"], f"{max(0.0, min(v, 1.0)):.3f}")

    def toggle_default_mute(self, key):
        n = default_node(self.objs, key)
        if n:
            wpctl("set-mute", n["id"], "toggle")
            GLib.timeout_add(120, lambda: self.refresh(force=True) and False)

    def set_phone_master(self, v):
        if self.state and self.state.get("owner") == "phone":
            ctl(op="volume", value=v)
        elif getattr(self, "phone_node", None):
            wpctl("set-volume", self.phone_node["id"], f"{v:.3f}")

    def mute_phone(self):
        if getattr(self, "phone_node", None):
            wpctl("set-mute", self.phone_node["id"], "toggle")

    # -- data
    def sharing(self):
        st = self.state
        return bool(st and ((st.get("owner") == "phone" and st.get("streaming"))
                            or (st.get("owner") == "laptop" and st.get("phone_linked"))))

    def refresh(self, force=False):
        self.state = demo_state() if DEMO else read_state()
        self.write_indicator()
        self.players = demo_players() if DEMO else self.mpris.players()
        self.np.update(self.now_playing())
        if not (self.win.get_visible() or force):
            return True
        self.objs = demo_objs() if DEMO else pw_objects()
        self.update_output()
        self.update_apps()
        self.update_mic()
        self.update_hub()
        self.update_phone()
        return True

    # -- now playing
    def now_playing(self):
        """The track for the center pill: a playing one first (laptop wins ties), or one paused
        less than PAUSED_LINGER ago."""
        want = [w.lower() for w in GEOM["media_players"]]

        def match(*names):
            return any(w in (n or "").lower() for n in names for w in want)
        cands = []
        for pl in self.players:
            if match(pl["bus"], pl["identity"], pl["entry"]) and pl["title"]:
                cands.append({"source": "laptop", "id": pl["bus"], "title": pl["title"], "artist": pl["artist"],
                              "playing": pl["status"] == "Playing", "length": pl.get("length", 0),
                              "position": pl.get("position", 0), "art_path": fetch_art(pl.get("art"))})
        st = self.state or {}
        if st.get("owner") == "phone":
            for m in st.get("phone_media") or []:
                if not (match(m["id"], m.get("app")) and m.get("title")):
                    continue
                art = fetch_art(m["art"]) if m.get("art") else None
                if not art and m.get("art_key"):
                    p = os.path.join(ART_DIR, m["art_key"] + ".jpg")
                    art = p if os.path.exists(p) else None
                cands.append({"source": "phone", "id": m["id"], "title": m["title"], "artist": m.get("artist", ""),
                              "playing": bool(m.get("playing")), "length": (m.get("dur") or 0) / 1000,
                              "position": (m.get("pos") or 0) / 1000, "art_path": art})
        elif st.get("owner") == "laptop" and st.get("phone_linked"):
            mac = st.get("phone_mac", "")
            pl = self.avrcp.player(mac) if mac else None
            if pl and pl["title"] and (not pl["name"] or match(pl["name"])):
                cands.append({"source": "avrcp", "id": pl["path"], "title": pl["title"], "artist": pl["artist"],
                              "playing": pl["status"] == "playing", "length": pl["length"],
                              "position": pl["position"], "art_path": None})
        if DEMO and cands:
            cands[0]["art_path"] = demo_art()
        now = time.monotonic()
        for c in cands:
            if c["playing"]:
                self.last_playing[(c["source"], c["id"])] = now
        live = [c for c in cands
                if c["playing"] or now - self.last_playing.get((c["source"], c["id"]), -1e9) < PAUSED_LINGER]
        if not live:
            return None
        live.sort(key=lambda c: (not c["playing"], c["source"] != "laptop"))
        return live[0]

    def np_command(self, t, cmd):
        if not t:
            return
        if cmd == "focus":
            if t["source"] == "laptop":
                subprocess.Popen(["sh", "-c", "swaymsg '[app_id=\"(?i)spotify\"] focus' >/dev/null 2>&1 || "
                                  "swaymsg '[class=\"(?i)spotify\"] focus' >/dev/null 2>&1"])
            return
        if t["source"] == "laptop":
            self.mpris.command(t["id"], cmd)
        elif t["source"] == "phone":
            ctl(op={"PlayPause": "toggle", "Next": "next", "Previous": "previous"}[cmd], id=t["id"])
        elif t["source"] == "avrcp":
            self.avrcp.command(t["id"], {"PlayPause": "Pause" if t["playing"] else "Play"}.get(cmd, cmd))
        if cmd == "PlayPause":  # answer the click now; the next poll confirms
            t["playing"] = not t["playing"]
            self.np.update(t)
        GLib.timeout_add(250, lambda: self.refresh() and False)

    def write_indicator(self):
        want = GEOM["indicator"] if self.sharing() else ""
        if want != self.indicator:
            self.indicator = want
            try:
                with open(INDICATOR + ".tmp", "w") as f:
                    f.write(want)
                os.replace(INDICATOR + ".tmp", INDICATOR)
            except OSError:
                pass

    def update_output(self):
        sink = default_node(self.objs, "default.audio.sink")
        vol, mute = node_volume(sink) if sink else (None, False)
        name = node_props(sink).get("node.description") or node_props(sink).get("node.name") or "No output"
        self.output.master.update("OUTPUT", name, vol, mute)
        cur = sink["id"] if sink else None
        devs = [(o["id"], node_props(o).get("node.description") or node_props(o).get("node.name", "?"), o["id"] == cur)
                for o in nodes_of(self.objs, "Audio/Sink")]
        self.output.sync_devices(devs, self.pick_output)

    def pick_output(self, node_id):
        wpctl("set-default", node_id)
        GLib.timeout_add(150, lambda: self.refresh(force=True) and False)

    def update_apps(self):
        rows = laptop_rows(self.objs, self.players)
        self.laptop_rows = {r["id"]: r for r in rows}
        items = [{"id": r["id"], "app": r["app"], "title": r["title"], "volume": r["volume"], "mute": r["mute"],
                  "playing": (r["player"]["status"] == "Playing") if r["player"] else None} for r in rows]
        self.apps.sync(items, self.app_callbacks)

    def app_callbacks(self, rid):
        def toggle():
            r = self.laptop_rows.get(rid)
            if r and r["player"]:
                self.mpris.play_pause(r["player"]["bus"])
                GLib.timeout_add(150, lambda: self.refresh(force=True) and False)

        def volume(v):
            for n in (self.laptop_rows.get(rid) or {}).get("nodes", []):
                wpctl("set-volume", n, f"{v:.3f}")

        def mute():
            for n in (self.laptop_rows.get(rid) or {}).get("nodes", []):
                wpctl("set-mute", n, "toggle")
            GLib.timeout_add(120, lambda: self.refresh(force=True) and False)
        return toggle, volume, mute

    def update_mic(self):
        src = default_node(self.objs, "default.audio.source")
        vol, mute = node_volume(src) if src else (None, False)
        name = node_props(src).get("node.description") or "No microphone"
        self.mic.master.update("MIC", name, vol, mute)
        cur = src["id"] if src else None
        devs = [(o["id"], node_props(o).get("node.description") or node_props(o).get("node.name", "?"), o["id"] == cur)
                for o in nodes_of(self.objs, "Audio/Source")]
        self.mic.sync_devices(devs, self.pick_output)

    def update_hub(self):
        """The switch shows while the headphones are on the phone, or the phone is linked over Bluetooth.
        (The app reports all the time now, for the clipboard, so "phone reports" alone isn't enough.)"""
        st = self.state or {}
        show = bool((st.get("phone") and st.get("phone_hp_linked")) or st.get("phone_linked"))
        for w in (self.hub, self.hub_sep):
            w.set_visible(show)
        if show:
            self.hub.update(st.get("prefer", "phone"), st.get("owner"))

    def update_phone(self):
        st = self.state
        show = self.sharing()
        self.phone.set_visible(show)
        self.phone_sep.set_visible(show)
        if not show:
            return
        items = []
        self.phone_node = None
        bat = st.get("phone_battery") or {}
        bat = f" · {bat['level']}%" if bat.get("level") is not None else ""
        if st.get("owner") == "phone":
            note = "media volume" if st.get("phone_media_access", True) else \
                "allow media access in the Tandem app to see players"
            self.phone.master.update("PHONE", note + bat, st.get("phone_volume"))
            for m in st.get("phone_media") or []:
                items.append({"id": "phone:" + m["id"], "app": m.get("app") or m["id"],
                              "title": " · ".join(x for x in (m.get("title"), m.get("artist")) if x),
                              "volume": m.get("volume"), "playing": bool(m.get("playing"))})
        else:
            # By address: "first bluez_input" also matched the headphones' own microphone.
            phone_mac = st.get("phone_mac", "").upper()
            node = next((o for o in nodes_of(self.objs, "Stream/Output/Audio") + nodes_of(self.objs, "Audio/Source")
                         if phone_mac and str(node_props(o).get("api.bluez5.address", "")).upper() == phone_mac),
                        None)
            vol, mute = node_volume(node) if node else (None, False)
            self.phone.master.update("PHONE", "over Bluetooth, through the laptop" + bat, vol, mute)
            self.phone_node = node
            pl = self.avrcp.player(phone_mac) if phone_mac and st.get("phone_linked") else None
            self.phone_player = pl
            if pl:
                items.append({"id": "avrcp", "app": "Phone", "volume": None,
                              "title": " · ".join(x for x in (pl["title"], pl["artist"]) if x),
                              "playing": pl["status"] == "playing"})
        self.phone.sync(items, self.phone_callbacks)

    def phone_callbacks(self, rid):
        def toggle():
            if rid == "avrcp":
                pl = self.phone_player
                if pl:
                    self.avrcp.toggle(pl["path"], pl["status"] == "playing")
            else:
                ctl(op="toggle", id=rid.split(":", 1)[1])

        def volume(v):
            if rid != "avrcp":
                ctl(op="volume", id=rid.split(":", 1)[1], value=v)
        return toggle, volume, None


