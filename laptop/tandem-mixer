class Row(Gtk.Box):
    """Name + title, play/pause, volume slider; click the % to mute. Updated in place, never rebuilt."""

    def __init__(self, on_toggle, on_volume, on_mute=None, master=False):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.on_toggle, self.on_volume, self.on_mute = on_toggle, on_volume, on_mute
        self.dragging = False
        self.pending = None
        top = Gtk.Box(spacing=8)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.app = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.app.get_style_context().add_class("section" if master else "app")
        self.title = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.title.get_style_context().add_class("where" if master else "title")
        text.pack_start(self.app, False, False, 0)
        text.pack_start(self.title, False, False, 0)
        top.pack_start(text, True, True, 0)
        self.pp = Gtk.Button(label="")
        self.pp.get_style_context().add_class("pp")
        self.pp.set_valign(Gtk.Align.CENTER)
        self.pp.connect("clicked", lambda *_: self.on_toggle())
        top.pack_end(self.pp, False, False, 0)
        self.pack_start(top, False, False, 0)
        bottom = Gtk.Box(spacing=6)
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 0.01)
        self.scale.set_draw_value(False)
        if master:
            self.scale.get_style_context().add_class("master")
        self.scale.connect("button-press-event", self._press)
        self.scale.connect("button-release-event", self._release)
        self.handler = self.scale.connect("value-changed", self._changed)
        pct_box = Gtk.EventBox()
        self.pct = Gtk.Label(xalign=1)
        self.pct.get_style_context().add_class("pct")
        pct_box.add(self.pct)
        pct_box.connect("button-press-event", lambda *_: self.on_mute and self.on_mute())
        bottom.pack_start(self.scale, True, True, 0)
        bottom.pack_end(pct_box, False, False, 0)
        self.pack_start(bottom, False, False, 0)
        self.bottom = bottom

    def _press(self, *_):
        self.dragging = True

    def _release(self, *_):
        self.dragging = False

    def _changed(self, scale):
        self.pct.set_text(f"{round(scale.get_value() * 100)}%")
        # Debounce: wpctl/the phone get the latest value at most ~16 times a second.
        if self.pending is None:
            self.pending = GLib.timeout_add(60, self._flush)

    def _flush(self):
        self.pending = None
        self.on_volume(self.scale.get_value())
        return False

    def update(self, app, title, volume, mute=False, playing=None):
        self.app.set_text(app)
        self.title.set_text(title or "")
        self.title.set_visible(bool(title))
        if playing is None:
            self.pp.set_visible(False)
        else:
            self.pp.set_visible(True)
            self.pp.set_label("󰏤" if playing else "󰐊")
            ctx = self.pp.get_style_context()
            (ctx.add_class if playing else ctx.remove_class)("playing")
        self.bottom.set_visible(volume is not None)
        if volume is not None and not self.dragging and self.pending is None:
            self.scale.handler_block(self.handler)
            self.scale.set_value(volume)
            self.scale.handler_unblock(self.handler)
            self.pct.set_text("muted" if mute else f"{round(volume * 100)}%")
        ctx = self.scale.get_style_context()
        (ctx.add_class if mute else ctx.remove_class)("muted")


class HubSwitch(Gtk.Box):
    """Which device carries the other's audio: [Laptop | Phone]. Click to switch; while the handoff runs,
    the target shows as pending and the note says what's happening."""

    def __init__(self, on_pick):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        top.get_style_context().add_class("hubrow")
