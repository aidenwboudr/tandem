def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def pw_objects():
    try:
        return json.loads(run("pw-dump") or "[]")
    except ValueError:
        return []


def node_volume(o):
    """Volume as wpctl shows it (cubic, 0..1+) and mute, from a pw-dump node."""
    for p in ((o.get("info") or {}).get("params") or {}).get("Props") or []:
        vols = p.get("channelVolumes")
        if vols:
            lin = sum(vols) / len(vols)
            return max(lin, 0) ** (1 / 3), bool(p.get("mute"))
    return None, False


class Mpris:
    """MPRIS players on the session bus: identity, desktop entry, title, status."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def _call(self, name, path, iface, method, args=None, sig=None):
        try:
            return self.bus.call_sync(name, path, iface, method, args, sig, Gio.DBusCallFlags.NONE, 500, None)
        except GLib.Error:
            return None

    def players(self):
        r = self._call("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "ListNames")
        names = [n for n in (r.unpack()[0] if r else []) if n.startswith("org.mpris.MediaPlayer2.")]
        out = []
        for n in names:
            root = self._getall(n, "org.mpris.MediaPlayer2")
            pl = self._getall(n, "org.mpris.MediaPlayer2.Player")
            md = pl.get("Metadata") or {}
            artist = md.get("xesam:artist") or []
            out.append({
                "bus": n, "identity": root.get("Identity") or n.split(".")[-1],
                "entry": (root.get("DesktopEntry") or "").lower(),
                "title": md.get("xesam:title") or "", "artist": ", ".join(artist) if isinstance(artist, list) else str(artist),
                "status": pl.get("PlaybackStatus") or "Stopped", "can_pause": pl.get("CanPause", True),
                "art": md.get("mpris:artUrl") or "", "length": (md.get("mpris:length") or 0) / 1e6,
                "position": (pl.get("Position") or 0) / 1e6, "album": md.get("xesam:album") or "",
            })
        return out

    def _getall(self, name, iface):
        r = self._call(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "GetAll",
                       GLib.Variant("(s)", (iface,)))
        return r.unpack()[0] if r else {}

    def play_pause(self, bus):
        self._call(bus, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlayPause")

    def command(self, bus, method):  # Next / Previous / PlayPause
        self._call(bus, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", method)


def norm(s):
    return "".join(ch for ch in (s or "").lower() if ch.isalnum())


IGNORE = []  # filled from GEOM["ignore_apps"] at startup


def laptop_rows(objs, players):
    """One row per app: its streams' volume + its MPRIS player's title and play/pause."""
    apps = {}
    for o in objs:
        p = (o.get("info") or {}).get("props") or {}
        if o.get("type") != "PipeWire:Interface:Node" or p.get("media.class") != "Stream/Output/Audio":
            continue
        name = p.get("node.name", "")
        if p.get("api.bluez5.address") or name.startswith("bluez_input") or name.startswith("tandem"):
            continue  # the phone's Bluetooth stream lives in the phone section
        app = p.get("application.name") or p.get("application.process.binary") or name
        if any(ig in norm(app) or ig in norm(p.get("application.process.binary")) for ig in IGNORE):
            continue  # always-open system streams (TTS, dictation) are not "something playing"
        vol, mute = node_volume(o)
        a = apps.setdefault(app, {"id": "app:" + app, "app": app, "title": p.get("media.name", ""),
                                  "bin": p.get("application.process.binary", ""), "nodes": [],
                                  "volume": vol, "mute": mute, "player": None})
        a["nodes"].append(o["id"])
        a["running"] = a.get("running") or (o.get("info") or {}).get("state") == "running"
        if vol is not None and (a["volume"] is None or vol > a["volume"]):
            a["volume"] = vol
    rows = list(apps.values())
    for pl in players:
        keys = {norm(pl["entry"]), norm(pl["identity"]), norm(pl["bus"].split(".")[3] if pl["bus"].count(".") >= 3 else "")}
        keys.discard("")
        match = next((a for a in rows if a["player"] is None and any(
            k and (k in norm(a["app"]) or norm(a["app"]) in k or (a["bin"] and norm(a["bin"]) in k)) for k in keys)), None)
        if match:
            match["player"] = pl
        elif pl["status"] in ("Playing", "Paused"):
            rows.append({"id": "mpris:" + pl["bus"], "app": pl["identity"], "title": "", "nodes": [],
                         "volume": None, "mute": False, "player": pl})
    # An app is listed while it's actually playing, or while it has a player (so a paused tab can resume).
    rows = [a for a in rows if a.get("running") or a["player"]]
    generic = {"audiostream", "playback", "audiocallbackdriver", "output", "audio", "webrtc"}
    for a in rows:
        pl = a["player"]
        if pl and pl["title"]:
            a["title"] = pl["title"] + (f" · {pl['artist']}" if pl["artist"] else "")
        elif norm(a["title"]) in generic or norm(a["title"]) == norm(a["app"]):
            a["title"] = ""
        if a["app"][:1].islower():
            a["app"] = a["app"][:1].upper() + a["app"][1:]
    return rows


