def nodes_of(objs, media_class):
    out = []
    for o in objs:
        p = (o.get("info") or {}).get("props") or {}
        if o.get("type") == "PipeWire:Interface:Node" and p.get("media.class") == media_class:
            out.append(o)
    return out


def node_props(o):
    return ((o or {}).get("info") or {}).get("props") or {}


def default_node(objs, key):
    name = None
    for o in objs:
        if o.get("type") == "PipeWire:Interface:Metadata" and (o.get("props") or {}).get("metadata.name") == "default":
            for m in o.get("metadata") or []:
                if m.get("key") == key:
                    v = m.get("value")
                    name = v.get("name") if isinstance(v, dict) else None
    return next((o for o in objs if o.get("type") == "PipeWire:Interface:Node"
                 and node_props(o).get("node.name") == name), None)


