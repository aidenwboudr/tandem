        self.pill = Gtk.Box(spacing=7)
        self.pill.get_style_context().add_class("np")
        self.pill.set_size_request(GEOM["np_width"], height)
        self.pill_css = Gtk.CssProvider()
        self.pill.get_style_context().add_provider(self.pill_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

        # Two pages (cover + text) so a track change is a crossfade, never a hard cut.
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=450)
        self.stack.set_hhomogeneous(False)  # size to the visible page (it shrinks in mini mode)
        self.pages = [self._page() for _ in range(2)]
        for i, (box, *_r) in enumerate(self.pages):
            self.stack.add_named(box, str(i))
        title_click = Gtk.EventBox()
        title_click.add(self.stack)
        title_click.connect("button-press-event", lambda *_: self.on_command(self.current, "focus"))
        self.pill.pack_start(title_click, True, True, 0)

        self.src = Gtk.Label()
        self.src.get_style_context().add_class("src")
        self.pill.pack_start(self.src, False, False, 0)
        self.buttons = {}
        for name, glyph in (("Previous", "󰒮"), ("PlayPause", "󰐊"), ("Next", "󰒭")):
            b = Gtk.Button(label=glyph)
            b.set_valign(Gtk.Align.CENTER)
            b.connect("clicked", lambda _b, n=name: self.on_command(self.current, n))
            if name == "PlayPause":
                b.get_style_context().add_class("play")
            self.buttons[name] = b
            self.pill.pack_start(b, False, False, 0)
        overlay.add(self.pill)

        self.progress = Gtk.Box()
        self.progress.get_style_context().add_class("progress")
        self.progress.set_halign(Gtk.Align.START)
        self.progress.set_valign(Gtk.Align.END)
        self.progress.set_margin_start(4)
        self.progress.set_size_request(0, 2)
        overlay.add_overlay(self.progress)
        overlay.set_overlay_pass_through(self.progress, True)

        self.win.add(overlay)
        self.fade = Fader(overlay, self.win.hide, ms=350)

    def _page(self):
        box = Gtk.Box(spacing=7)
        art = Gtk.Box()
        art.get_style_context().add_class("art")
        art.set_valign(Gtk.Align.CENTER)
        art_css = Gtk.CssProvider()
        art.get_style_context().add_provider(art_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        noart = Gtk.Label(label="󰎈")
        noart.get_style_context().add_class("noart")
        song = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        song.get_style_context().add_class("song")
        song.set_use_markup(True)
        song.set_max_width_chars(max(3, int((GEOM["np_width"] - 155) / 7.3)))
        box.pack_start(art, False, False, 0)
        box.pack_start(noart, False, False, 0)
        box.pack_start(song, True, True, 0)
        return box, art, art_css, noart, song

    def _fill(self, page, t):
        box, art, art_css, noart, song = page
        title = GLib.markup_escape_text(t["title"] or "Unknown")
        artist = GLib.markup_escape_text(t.get("artist") or "")
        show_artist = artist and self.mode == "full"
        song.set_markup(f"{title}" + (f"  <span foreground='#8087a2'>{artist}</span>" if show_artist else ""))
        song.set_visible(self.mode != "mini")
        path = t.get("art_path")
        if path:
            uri = GLib.filename_to_uri(path, None)
            art_css.load_from_data(f'* {{ background-image: url("{uri}"); }}'.encode())
        art.set_visible(bool(path))
        noart.set_visible(not path)
        page[0].show()

    def _set_tint(self, rgb):
        if rgb == self.tint:
            return
        self.tint = rgb
        if rgb:
            r, g, b = rgb
            css = (f".np {{ background-color: rgba(54, 58, 79, 0.55); background-image: linear-gradient(90deg, "
                   f"rgba({r}, {g}, {b}, 0.32), rgba({r}, {g}, {b}, 0.10) 45%, rgba({r}, {g}, {b}, 0) 80%); }}")
        else:
            css = ".np { background-image: none; }"
        self.pill_css.load_from_data(css.encode())

    def remap(self):
        """waybar restarted and is now stacked above us: unmap/map to come back on top."""
        if self.win.get_visible() and self.current:
            t = self.current
            self.win.hide()
            self.current = None
            GLib.timeout_add(400, lambda: self.update(t, force=True) and False)

    def set_bounds(self, left_end, right_start, bar_width):
        """Fit between the bar's left and right modules (reported live by waybar-hover.so)."""
        cx = bar_width / 2
        room = 2 * (min(cx - left_end, right_start - cx) - 12)
        width = int(min(GEOM["np_width"], room))
        mode = "full" if width >= 300 else "title" if width >= 210 else "mini" if width >= 145 else "hidden"
        if width == self.width and mode == self.mode:
            return
        self.width, self.mode = width, mode
        self.pill.set_size_request(max(width, 0), GEOM["bar_height"] - 6)
        # Cap the song's natural width so the pill never grows past the room it has
        # (cover + badge + 3 buttons + spacing ~ 155 px; JetBrains Mono 12px ~ 7.3 px/char).
        chars = max(3, int((width - 155) / 7.3))
        for page in self.pages:
            page[4].set_max_width_chars(chars)
        self.win.resize(1, 1)  # let the layer surface shrink, not just grow
        if self.current:
            t, self.current = self.current, None
            self.update(t, force=True)

    def update(self, t, force=False):
        if t and self.mode == "hidden":  # no room in the bar right now: step aside, keep the track
            if self.current is not None:
                self.fade.to(0.0)
            self.current = t
            t["_key"] = None
            return
        if not t:
            if self.current is not None:
                self.current = None
                self.fade.to(0.0)
            return
        key = (t["source"], t["title"], t.get("artist"), t.get("art_path"))
        changed = force or self.current is None or key != self.current.get("_key")
        t["_key"] = key
        appearing = self.current is None
        self.current = t
        if changed:
            if appearing or force:
                self._fill(self.pages[self.page], t)
                self.stack.set_visible_child_name(str(self.page))
            else:
                self.page ^= 1
                self._fill(self.pages[self.page], t)
                self.stack.set_visible_child_name(str(self.page))
            self._set_tint(art_tint(t["art_path"]) if t.get("art_path") else None)
        self.buttons["PlayPause"].set_label("󰏤" if t["playing"] else "󰐊")
        self.src.set_text("󰄜" if t["source"] != "laptop" else "")
        self.src.set_visible(t["source"] != "laptop" and self.mode != "mini")
        frac = (t["position"] / t["length"]) if t.get("length") else 0
        width = self.width - 8
        self.progress.set_size_request(max(0, min(width, int(width * frac))), 2)
        self.progress.set_visible(bool(t.get("length")))
        if appearing or not self.win.get_visible():
            self.win.show_all()
            self._fill(self.pages[self.page], t)  # show_all() undid the art/noart/song visibility
            self.src.set_visible(t["source"] != "laptop" and self.mode != "mini")
            self.progress.set_visible(bool(t.get("length")))
        self.fade.to(1.0)


