            transparent(self.win)
        inset = 3
        if GtkLayerShell is not None:
            GtkLayerShell.init_for_window(self.win)
            GtkLayerShell.set_namespace(self.win, "tandem-np")
            GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.TOP)  # like waybar: hidden by fullscreen
            GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.TOP, True)
