<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The link: Bluetooth (pairing, small messages) and the network (TLS to the computer). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Lets the always-on link run as a connectedDevice service even before Bluetooth is allowed. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- App names and icons for mirrored notifications and the computer's mixer. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- "Display over other apps": the only way to open an app or a link from the background (the play
         button, links from the computer, reading copies). Nothing is ever drawn over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Automatic phone -> computer clipboard: only granted over adb
         (`adb shell pm grant com.aidenwb.tandem android.permission.READ_LOGS`). The app reads one line
         from it, the system's "denying clipboard access" for this app, to know something was copied. -->
    <uses-permission android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Optional features; each is asked for only when you turn its switch on. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Tandem"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads the clipboard for the computer: Android only lets the focused app do that. Invisible. -->
        <activity
            android:name=".ClipGrabActivity"
            android:exported="true"
            android:label="Computer clipboard"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Share -> "Send to computer": files, links, text. Invisible. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Send to computer"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Images from the computer's clipboard, for the app that pastes them. -->
        <provider
            android:name=".ClipProvider"
            android:authorities="com.aidenwb.tandem.clips"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- These Bluetooth broadcasts are exempt from the implicit-broadcast ban, and receiving one
             lets the app start its foreground service from the background. -->
        <receiver
            android:name=".BtReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Buttons on the app's own notifications. -->
        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />

        <!-- Notification access: mirrored notifications, codes, callers, and the phone's media sessions. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="Tandem"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- "Tandem keyboard": types what the computer sends (`tandem type`). -->
        <service
            android:name=".Keyboard"
            android:exported="true"
            android:label="Tandem keyboard (type from the computer)"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
